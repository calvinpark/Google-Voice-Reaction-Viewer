{
  "manifest_version": 2,
  "name": "Google Voice Reaction Viewer",
  "version": "0.1.1",
  "description": "Shows iMessage tapback reactions (Loved “…”, Liked “…”, Reacted 😂 to “…”) as emoji badges on the message they refer to in Google Voice, and dims the text-only reaction rows.",
  "author": "Calvin Park",
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://voice.google.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "{90091e07-01ce-012e-ac71-017071e77e12}",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
